<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/payeesLayout" style="@style/ListItem">
<LinearLayout style="@style/DetailRow">
<TextView android:id="@+id/payeeName" style="@style/Headline" />
<TextView android:id="@+id/payeeType" style="@style/HeadlineRight" />
</LinearLayout>
<LinearLayout android:id="@+id/payeeRowAccount1" style="@style/DetailRow">
<TextView android:text="Account" style="@style/DetailLabel" />
<TextView android:id="@+id/payeeAccount" style="@style/DetailValue" />
</LinearLayout>
<LinearLayout android:id="@+id/payeeRowAccount2" style="@style/DetailRow">
<TextView android:text="Sort code" style="@style/DetailLabel" />
<TextView android:id="@+id/payeeNSC" style="@style/DetailValue" />
</LinearLayout>
<LinearLayout android:id="@+id/payeeRowReference" style="@style/DetailRow">
<TextView android:text="Reference" style="@style/DetailLabel" />
<TextView android:id="@+id/payeeReference" style="@style/DetailValue" />
</LinearLayout>
<LinearLayout android:id="@+id/payeeRowOptions" style="@style/DetailRow">
<Button android:id="@+id/payeeAmendButton" android:text="Amend" style="@style/RowAction" />
<Button android:id="@+id/payeeDeleteButton" android:text="Delete" style="@style/RowAction" />
<Button android:id="@+id/payeePaymentButton" android:text="Make payment" style="@style/RowAction" />
</LinearLayout>
</LinearLayout>
