<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/LoginScreen">
<LinearLayout style="@style/LoginColumn">
<ImageView style="@style/LoginLogo" android:src="@drawable/aiblogo" android:maxWidth="100dp" android:layout_marginTop="0dp" />
<TextView style="@style/LoginPromptWide" android:text="Please enter the following digits from your Personal Access Code (PAC):" />
<LinearLayout style="@style/PacRow">
<TextView android:id="@+id/dpac1" android:text="1" style="@style/PacIndex" />
<EditText android:id="@+id/pac1" style="@style/PacEntry" />
<TextView android:id="@+id/dpac2" android:text="2" style="@style/PacIndex" />
<EditText android:id="@+id/pac2" style="@style/PacEntry" />
<TextView android:id="@+id/dpac3" android:text="3" style="@style/PacIndex" />
<EditText android:id="@+id/pac3" style="@style/PacEntry" />
</LinearLayout>
<TextView android:id="@+id/challengePhrase" style="@style/LoginPromptWide" android:layout_marginTop="20dp" android:text="Please enter the last four digits from your home phone number" />
<EditText android:id="@+id/challengeNumber" style="@style/ChallengeField" android:inputType="number" />
<Button android:id="@+id/loginButton" android:text="Next" style="@style/LoginNext" android:onClick="onClick" />
</LinearLayout>
</LinearLayout>
